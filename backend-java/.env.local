# Local dev environment for backend-java
# Used by start scripts; not committed.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/enterprise_ai_copilot
SPRING_DATASOURCE_USERNAME=copilot
SPRING_DATASOURCE_PASSWORD=copilot_dev

# JWT signing secret (>=32 bytes required by SecurityConfig.signingKey)
AUTH_JWT_SECRET=local-dev-secret-please-change-in-production-32bytes
AUTH_JWT_ISSUER=enterprise-ai-copilot
AUTH_JWT_AUDIENCE=enterprise-ai-copilot
AUTH_JWT_TTL_SECONDS=3600
AUTH_COOKIE_SECURE=false

# Demo auth seed (zhangsan / lisi / wangwu + admin). Enable with shared default password.
DEMO_AUTH_ENABLED=true
DEMO_AUTH_DEFAULT_PASSWORD=Demo@12345
DEMO_AUTH_ZHANGSAN_ANNUAL_BALANCE=10.0
DEMO_AUTH_LISI_ANNUAL_BALANCE=5.0
DEMO_AUTH_WANGWU_ANNUAL_BALANCE=15.0

# Internal token shared with agent-python for leave_read endpoints
JAVA_INTERNAL_TOKEN=local-internal-token

# Admin token empty = Demo mode (X-Allow-Eval=true opens eval routes)
ADMIN_TOKEN=

# Controlled business actions: enable so leave_proposal_tool can propose real leave
BUSINESS_ACTIONS_ENABLED=true
BUSINESS_ACTIONS_REQUIRE_ADMIN=false
BUSINESS_ACTION_TTL_SECONDS=600
BUSINESS_ACTIONS_MAX_PENDING=100