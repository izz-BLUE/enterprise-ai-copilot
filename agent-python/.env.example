# =============================================================================
# Enterprise AI Copilot - Python AI Service 环境变量配置
# =============================================================================
# 复制此文件为 .env 并填写实际值：
#   cp .env.example .env
#
# 不要将 .env 提交到 Git！
# =============================================================================

# -----------------------------------------------------------------------------
# 必填配置
# -----------------------------------------------------------------------------

# DeepSeek API Key（必填，LLM 调用必需）
DEEPSEEK_API_KEY=your_api_key_here

# -----------------------------------------------------------------------------
# LLM 配置（可选，使用 SDK 默认值）
# -----------------------------------------------------------------------------

# DeepSeek API 地址（可选）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名称（可选）
# DEEPSEEK_MODEL=deepseek-chat

# LLM 温度参数（默认 0）
# DEEPSEEK_TEMPERATURE=0

# LLM 调用超时，单位秒（默认 30）
# LLM_TIMEOUT=30

# -----------------------------------------------------------------------------
# Embedding 模型配置（可选）
# -----------------------------------------------------------------------------

# 模型名称（默认 BAAI/bge-small-zh-v1.5）
# EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5

# 推理后端（默认 torch）：
#   torch        — SentenceTransformer + PyTorch（兼容性最好，内存最大）
#   onnx_st      — SentenceTransformer ONNX 后端（仍加载 torch，不节省内存）
#   onnx_direct  — Direct ONNX Runtime（不加载 torch，生产环境推荐）
# EMBEDDING_BACKEND=torch

# 本地模型目录（onnx_st/onnx_direct 可选/必须，不设置时从 HuggingFace 下载）
# EMBEDDING_MODEL_PATH=

# ONNX 文件名（默认 onnx/model.onnx）
# EMBEDDING_ONNX_FILE=onnx/model.onnx

# ONNX Provider（默认 CPUExecutionProvider，ONNX 模式必须使用此值）
# EMBEDDING_PROVIDER=CPUExecutionProvider

# 服务器部署 Direct ONNX 模式示例（推荐）：
# EMBEDDING_BACKEND=onnx_direct
# EMBEDDING_MODEL_PATH=/app/models/embedding/bge-small-zh-v1.5-onnx
# EMBEDDING_ONNX_FILE=onnx/model.onnx
# EMBEDDING_PROVIDER=CPUExecutionProvider
#
# 注意：ONNX 模型文件不提交 Git，需通过导出脚本生成：
#   uv run python scripts/build/export_embedding_onnx.py

# -----------------------------------------------------------------------------
# 输入校验（可选）
# -----------------------------------------------------------------------------

# 输入消息最大长度，单位字符（默认 2000）
# MAX_MESSAGE_LENGTH=2000

# -----------------------------------------------------------------------------
# 实验功能（可选，不建议默认启用）
# -----------------------------------------------------------------------------

# 查询重写模式：none（默认）/ rule（实验模式）
# REWRITE_MODE=none

# Cross Encoder 精排模型（实验模式 hybrid_rerank 使用）
# RERANK_MODEL=BAAI/bge-reranker-base

# 精排候选数量（默认 10）
# RERANK_CANDIDATE_K=10

# 实验性检索相关性 Gate：off（默认）/ shadow
# 独立 Holdout 已证明 Vector/BM25 不能可靠判断答案证据是否充分，默认关闭。
# shadow 仅用于离线分析和非阻断日志；enforce 未开放，配置后服务会拒绝启动。
# RAG_GATE_MODE=off

# 以下阈值仅用于复现首轮 Shadow 实验，不是经过验证的可部署参数。
# RAG_VECTOR_STRONG_THRESHOLD=0.65
# RAG_VECTOR_WEAK_THRESHOLD=0.61
# RAG_BM25_WEAK_THRESHOLD=2.10

# -----------------------------------------------------------------------------
# 网络环境（可选）
# -----------------------------------------------------------------------------

# HuggingFace 离线模式（国内网络环境必须，模型需提前下载到本地缓存）
# HF_HUB_OFFLINE=1
