# =============================================================================
# Enterprise AI Copilot - Python AI Service 环境变量配置
# =============================================================================
# 复制此文件为 .env 并填写实际值：
#   cp .env.example .env
#
# 不要将 .env 提交到 Git！
# =============================================================================

# -----------------------------------------------------------------------------
# 必填配置
# -----------------------------------------------------------------------------

# DeepSeek API Key（必填，LLM 调用必需）
DEEPSEEK_API_KEY=your_api_key_here

# -----------------------------------------------------------------------------
# LLM 配置（可选，使用 SDK 默认值）
# -----------------------------------------------------------------------------

# DeepSeek API 地址（可选）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名称（可选）
# DEEPSEEK_MODEL=deepseek-chat

# LLM 温度参数（默认 0）
# DEEPSEEK_TEMPERATURE=0

# LLM 调用超时，单位秒（默认 30）
# LLM_TIMEOUT=30

# 单次模型最大输出 Token（默认 1024）
# LLM_MAX_OUTPUT_TOKENS=1024

# SDK 级重试次数（默认 0，避免与上游超时预算叠加）
# LLM_MAX_RETRIES=0

# 整个 Agent 请求截止时间，单位秒（默认 40）
# AGENT_REQUEST_TIMEOUT_SECONDS=40

# AI 请求并发槽（默认 3）
# AI_MAX_CONCURRENT_REQUESTS=3

# 获取并发槽最长等待时间，单位毫秒（默认 500）
# AI_QUEUE_TIMEOUT_MS=500

# -----------------------------------------------------------------------------
# Embedding 模型配置（可选）
# -----------------------------------------------------------------------------

# 模型名称（默认 BAAI/bge-small-zh-v1.5）
# EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5

# 推理后端（默认 torch）：
#   torch        — SentenceTransformer + PyTorch（兼容性最好，内存最大）
#   onnx_st      — SentenceTransformer ONNX 后端（仍加载 torch，不节省内存）
#   onnx_direct  — Direct ONNX Runtime（不加载 torch，生产环境推荐）
# EMBEDDING_BACKEND=torch

# 本地模型目录（onnx_st/onnx_direct 可选/必须，不设置时从 HuggingFace 下载）
# EMBEDDING_MODEL_PATH=

# ONNX 文件名（默认 onnx/model.onnx）
# EMBEDDING_ONNX_FILE=onnx/model.onnx

# ONNX Provider（默认 CPUExecutionProvider，ONNX 模式必须使用此值）
# EMBEDDING_PROVIDER=CPUExecutionProvider

# 服务器部署 Direct ONNX 模式示例（推荐）：
# EMBEDDING_BACKEND=onnx_direct
# EMBEDDING_MODEL_PATH=/app/models/embedding/bge-small-zh-v1.5-onnx
# EMBEDDING_ONNX_FILE=onnx/model.onnx
# EMBEDDING_PROVIDER=CPUExecutionProvider
#
# 注意：ONNX 模型文件不提交 Git，需通过导出脚本生成：
#   uv run python scripts/build/export_embedding_onnx.py

# -----------------------------------------------------------------------------
# 输入校验（可选）
# -----------------------------------------------------------------------------

# 输入消息最大长度，单位字符（默认 2000）
# MAX_MESSAGE_LENGTH=2000

# -----------------------------------------------------------------------------
# 实验功能（可选，不建议默认启用）
# -----------------------------------------------------------------------------

# 查询重写模式：none（默认）/ rule（实验模式）
# REWRITE_MODE=none

# Agent Loop（Planner ⇄ Tool Executor）开关：true（默认，仓库部署默认 Planner-first）/ false（显式回退旧确定性 Graph）
# 注意：这是开发示例；生产 runtime 由 deploy/docker-compose.prod.yml 与实际 deploy/.env / 环境变量配置决定。
AGENT_LOOP_ENABLED=true

# Cross Encoder 精排模型（实验模式 hybrid_rerank 使用）
# RERANK_MODEL=BAAI/bge-reranker-base

# 精排候选数量（默认 10）
# RERANK_CANDIDATE_K=10

# 实验性检索相关性 Gate：off（默认）/ shadow / enforce
# 独立 Holdout 已证明 Vector/BM25 不能可靠判断答案证据是否充分，默认关闭。
# shadow 仅记录不阻断；enforce 会阻断低相关结果，评估器异常时安全拒答，
# 仅可在目标数据集完成阈值验收后启用。
# RAG_GATE_MODE=off

# 以下阈值仅用于复现首轮 Shadow 实验，不是经过验证的可部署参数。
# RAG_VECTOR_STRONG_THRESHOLD=0.65
# RAG_VECTOR_WEAK_THRESHOLD=0.61
# RAG_BM25_WEAK_THRESHOLD=2.10

# -----------------------------------------------------------------------------
# 网络环境（可选）
# -----------------------------------------------------------------------------

# HuggingFace 离线模式（国内网络环境必须，模型需提前下载到本地缓存）
# HF_HUB_OFFLINE=1

# -----------------------------------------------------------------------------
# Phoenix/OpenTelemetry 观测性（可选，默认关闭）
# -----------------------------------------------------------------------------

# 开启后使用 OpenInference 自动插桩 OpenAI SDK 与 LangChain/LangGraph，
# 并通过 BatchSpanProcessor 异步发送到 Phoenix Collector。
# 默认不记录 Prompt、用户输入、检索正文和模型输出；如需本地调试可显式开启正文采集。
# PHOENIX_TRACING=false
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317
# PHOENIX_PROJECT_NAME=enterprise-ai-copilot
# PHOENIX_SAMPLE_RATE=1.0
# PHOENIX_CAPTURE_CONTENT=false
# PHOENIX_API_KEY=  # 仅启用 Phoenix 鉴权或使用远程实例时配置

# -----------------------------------------------------------------------------
# 企业只读 Tool（可选）
# -----------------------------------------------------------------------------

# Java 后端地址；空值时只读 Tool 返回 LEAVE_READ_DISABLED。
# JAVA_BASE_URL=http://localhost:8080

# 与 Java leave.read.internal-token 完全一致；缺失时只读 Tool 不可用。
# JAVA_INTERNAL_TOKEN=

# Python → Java 内部接口固定超时秒数；不做重试 / fallback。
# JAVA_TIMEOUT_SECONDS=5

# Scoped Conversation Memory P0 写入模式：DISABLED（默认）/ AUDIT_ONLY / ENABLED。
# DISABLED 不调用 Memory Extractor；AUDIT_ONLY 只生成提案并记录元数据；
# ENABLED 随当前 Agent 响应返回 UPSERT + ACTIVE 提案，由 Java 认证上下文落库。
MEMORY_WRITE_MODE=DISABLED
