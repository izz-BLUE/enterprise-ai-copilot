# Enterprise AI Copilot — Production Environment Variables
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# File permissions must be 600: chmod 600 .env

# DeepSeek API (required)
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# LangGraph durable runtime (required by the Python service).
# The service always uses PostgreSQL checkpoints and Planner-first execution.
LANGGRAPH_CHECKPOINT_DSN=postgresql://checkpoint_user:replace_me@postgres:5432/enterprise_ai_runtime
LANGGRAPH_CHECKPOINT_CONNECT_TIMEOUT_SECONDS=3

# Phoenix/OpenTelemetry tracing is opt-in. Start the optional console with:
#   docker compose --profile observability up -d
# Port 6006 is bound to localhost only by docker-compose.prod.yml.
PHOENIX_TRACING=false
PHOENIX_PROJECT_NAME=enterprise-ai-copilot
PHOENIX_SAMPLE_RATE=1.0
PHOENIX_CAPTURE_CONTENT=false
PHOENIX_DEFAULT_RETENTION_POLICY_DAYS=7
PHOENIX_UI_PORT=6006

# Server-only Admin Token for optional business-action hardening (REQUIRED by
# the production Compose contract, but never exposed to browser users).
# Must be a strong random value. Generate with:
#   openssl rand -hex 32
# Evaluation and /api/admin/** are authorized by the verified JWT role=ADMIN.
# Production Compose refuses to start if ADMIN_TOKEN is empty so the explicit
# BUSINESS_ACTIONS_REQUIRE_ADMIN=true hardening mode can be enabled safely.
ADMIN_TOKEN=CHANGE_ME_TO_A_STRONG_RANDOM_VALUE

# Controlled business actions are disabled by default. When enabled, Java
# trusted identity policy allows normal employees and permanently denies the
# public demo account. Set REQUIRE_ADMIN=true only for explicit server-side
# hardening; the browser must never receive or send ADMIN_TOKEN.
BUSINESS_ACTIONS_ENABLED=false
BUSINESS_ACTIONS_REQUIRE_ADMIN=false

# 模拟 OA 仅在需要演示外部审批闭环时开启；浏览器始终只访问 Java。
MOCK_OA_ENABLED=false
MOCK_OA_IMAGE=enterprise-ai-copilot-mock-oa:6e24f52
MOCK_OA_WEBHOOK_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_VALUE
MOCK_OA_WEBHOOK_TIMEOUT_SECONDS=5
