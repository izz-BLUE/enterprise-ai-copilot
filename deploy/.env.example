# Enterprise AI Copilot — Production Environment Variables
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# File permissions must be 600: chmod 600 .env

# DeepSeek API (required)
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Query Rewrite mode: none / rule
# Local default: none (no rewrite)
# Production: rule (rule-based rewrite for colloquial queries)
REWRITE_MODE=rule

# Admin Token for Evaluation access control (REQUIRED for production)
# Must be a strong random value. Generate with:
#   openssl rand -hex 32
# Empty value = Demo mode (all users can access Evaluation) — LOCAL DEVELOPMENT ONLY
# Production Compose will refuse to start if ADMIN_TOKEN is empty.
ADMIN_TOKEN=CHANGE_ME_TO_A_STRONG_RANDOM_VALUE
