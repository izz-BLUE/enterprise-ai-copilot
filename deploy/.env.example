# Enterprise AI Copilot —— 生产环境变量
#
# 将此文件复制为 .env 并填写真实值。
# 切勿将 .env 提交到版本控制。
# 文件权限必须为 600：chmod 600 .env

# DeepSeek API（必填）
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# LangGraph 持久化运行时（Python 服务必需）。
# 服务始终使用 PostgreSQL 检查点和 Planner-first 执行。
LANGGRAPH_CHECKPOINT_DSN=postgresql://checkpoint_user:replace_me@postgres:5432/enterprise_ai_runtime
LANGGRAPH_CHECKPOINT_CONNECT_TIMEOUT_SECONDS=3

# Phoenix/OpenTelemetry 追踪默认关闭。使用以下命令启动可选控制台：
#   docker compose --profile observability up -d
# 端口 6006 仅由 docker-compose.prod.yml 绑定到 localhost。
PHOENIX_TRACING=false
PHOENIX_PROJECT_NAME=enterprise-ai-copilot
PHOENIX_SAMPLE_RATE=1.0
PHOENIX_CAPTURE_CONTENT=false
PHOENIX_DEFAULT_RETENTION_POLICY_DAYS=7
PHOENIX_UI_PORT=6006

# 仅服务端使用的 Admin Token，用于可选的业务动作加固（生产 Compose 契约要求，
# 但绝不暴露给浏览器用户）。
# 必须使用高强度随机值。生成命令：
#   openssl rand -hex 32
# 评估能力和 /api/admin/** 由已验证 JWT 的 role=ADMIN 授权。
# 如果 ADMIN_TOKEN 为空，生产 Compose 会拒绝启动，以便安全启用显式的
# BUSINESS_ACTIONS_REQUIRE_ADMIN=true 加固模式。
ADMIN_TOKEN=CHANGE_ME_TO_A_STRONG_RANDOM_VALUE

# 受控业务动作默认关闭。启用后，Java 可信身份策略允许普通员工，并永久拒绝
# 公开 Demo 账号。仅在明确需要服务端加固时设置 REQUIRE_ADMIN=true；浏览器永远
# 不得接收或发送 ADMIN_TOKEN。
BUSINESS_ACTIONS_ENABLED=false
BUSINESS_ACTIONS_REQUIRE_ADMIN=false

# 模拟 OA 仅在需要演示外部审批闭环时开启；浏览器始终只访问 Java。
MOCK_OA_ENABLED=false
MOCK_OA_IMAGE=enterprise-ai-copilot-mock-oa:6e24f52
MOCK_OA_WEBHOOK_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_VALUE
MOCK_OA_WEBHOOK_TIMEOUT_SECONDS=5
