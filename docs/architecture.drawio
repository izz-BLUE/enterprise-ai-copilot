  <diagram name="部署拓扑" id="page-deploy">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="u1" value="用户浏览器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="190" height="70" as="geometry" />
        </mxCell>

        <mxCell id="net1" value="Docker: deploy_eat-what-net" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="40" width="700" height="230" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="Nginx&#xa;0.0.0.0:80/443 · TLS 终止&#xa;/api 反向代理 · 限流 2 req/s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="net1">
          <mxGeometry x="40" y="60" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="jv" value="Java Backend&#xa;127.0.0.1:8080（仅本机绑定）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="net1">
          <mxGeometry x="380" y="60" width="280" height="80" as="geometry" />
        </mxCell>

        <mxCell id="net2" value="Docker: ai-copilot-net" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="340" width="700" height="290" as="geometry" />
        </mxCell>
        <mxCell id="py" value="Python Agent&#xa;expose 8000（不映射公网）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="net2">
          <mxGeometry x="40" y="70" width="280" height="80" as="geometry" />
