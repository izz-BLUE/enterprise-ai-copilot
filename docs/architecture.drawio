        <mxCell id="m1" value="models/:ro&#xa;（ONNX 模型）" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;boundedLbl=1;" vertex="1" parent="net2">
          <mxGeometry x="380" y="70" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="data/processed/:ro&#xa;（FAISS 索引等）" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;boundedLbl=1;" vertex="1" parent="net2">
          <mxGeometry x="540" y="70" width="140" height="80" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Java 同时连接两个 Docker 网络；Nginx 无法直接访问 Python。模型与 processed 数据只读挂载。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="300" y="660" width="700" height="60" as="geometry" />
